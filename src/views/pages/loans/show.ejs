<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/">Главная</a> &nbsp;›&nbsp; <a href="/loans">Кредиты</a> &nbsp;›&nbsp; Договор № <%= loan.id %></nav>
<section class="panel loan-hero">
  <div class="muted2">Остаток долга, договор № <%= loan.id %><%= loan.status === 'active' ? '' : ' (погашен)' %></div>
  <div class="balance-big"><%= formatAmount(loan.principal_balance) %> <small class="muted unit">BYN</small></div>
  <% const paidPct = Math.round(((loan.amount - loan.principal_balance) / loan.amount) * 100); %>
  <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= paidPct %>" aria-label="Погашено"><span class="progress__fill" data-progress="<%= paidPct %>"></span></div>
  <p class="muted2 small mt8">Погашено <%= paidPct %>% от <%= formatAmount(loan.amount) %> BYN</p>
  <dl class="facts">
    <div><dt>Выдано</dt><dd><%= formatAmount(loan.amount) %> BYN</dd></div>
    <div><dt>Ставка</dt><dd><%= String(Number(loan.rate_percent)).replace('.', ',') %>% годовых</dd></div>
    <div><dt>Следующий платёж</dt><dd><%= next ? String(next.due_date).slice(0, 10).split('-').reverse().join('.') + ', ' + formatAmount(next.principal + next.interest + next.penalty) + ' BYN' : '—' %></dd></div>
    <% if (dpd > 0) { %><div><dt>Просрочка</dt><dd class="text-bad"><%= dpd %> дн.</dd></div><% } %>
  </dl>
</section>
<% if (loan.status === 'active') { const upcoming = schedule.filter((r) => r.status !== 'paid').slice(0, 3); %>
<section class="repay">
  <div class="repay__main">
    <div class="chips" role="tablist" aria-label="Вид погашения">
      <button class="chip" type="button" role="tab" aria-selected="true" data-repay-tab="partial">Частично досрочно</button>
      <button class="chip" type="button" role="tab" aria-selected="false" data-repay-tab="full">Полностью</button>
    </div>
    <form class="panel form" id="repay-partial" method="post" action="/loans/<%= loan.id %>/repay-partial" novalidate data-balance="<%= loan.principal_balance %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (errors.common) { %><div class="alert alert--error" role="alert"><%= errors.common %></div><% } %>
      <div class="field<%= errors.amount ? ' field--error' : '' %>"><label for="amount">Сумма платежа, BYN</label><input class="repay__amount" id="amount" name="amount" value="<%= form.amount || '' %>" inputmode="decimal" autocomplete="off"><span class="field__hint" id="repay-msg">Введите сумму досрочного платежа.</span><% if (errors.amount) { %><span class="field__error"><%= errors.amount %></span><% } %></div>
      <fieldset class="seg">
        <legend>После частичного платежа</legend>
        <div class="seg__in">
          <label><input type="radio" name="mode" value="term"<%= form.mode !== 'payment' ? ' checked' : '' %>><span>Сократить срок</span></label>
          <label><input type="radio" name="mode" value="payment"<%= form.mode === 'payment' ? ' checked' : '' %>><span>Снизить платёж</span></label>
        </div>
      </fieldset>
      <p class="repay__effect" id="repay-effect">Платёж по графику останется прежним, срок сократится.</p>
      <p class="muted2 m0 small">Дополнительно списываются проценты с даты последнего платежа по сегодня.</p>
      <div><button class="btn btn--lg" type="submit">Погасить часть</button></div>
    </form>
    <form class="panel form" id="repay-full" method="post" action="/loans/<%= loan.id %>/repay-full" hidden>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <dl class="facts m0">
        <div><dt>Основной долг</dt><dd><%= formatAmount(quote.principal) %></dd></div>
        <div><dt>Проценты на сегодня</dt><dd><%= formatAmount(quote.interest) %></dd></div>
        <% if (quote.penalty > 0) { %><div><dt>Пеня</dt><dd><%= formatAmount(quote.penalty) %></dd></div><% } %>
      </dl>
      <p class="repay__effect">Кредит будет закрыт сегодня, дальнейших процентов не будет.</p>
      <div class="amount"><%= formatAmount(quote.total) %> <small>BYN</small></div>
      <div><button class="btn btn--lg" type="submit">Погасить полностью</button></div>
    </form>
  </div>
  <aside class="panel upcoming">
    <h2>Ближайшие платежи</h2>
    <% upcoming.forEach((r) => { %>
      <div class="upcoming__row"><div><b><%= String(r.due_date).slice(0, 10).split('-').reverse().join('.') %></b><small>долг <%= formatAmount(r.principal) %>, проценты <%= formatAmount(r.interest) %></small></div><b><%= formatAmount(r.principal + r.interest + r.penalty) %></b></div>
    <% }) %>
    <p class="muted2 small m0">Плановые платежи списываются автоматически при закрытии операционного дня.</p>
  </aside>
</section>
<script src="/js/repay.js" defer></script>
<% } %>
<section class="panel">
  <h2 class="mb14">График платежей</h2>
  <div class="scroll-x"><table class="table">
    <thead><tr><th>№</th><th>Дата</th><th>Долг</th><th>Проценты</th><th>Пеня</th><th>Платёж</th><th>Статус</th></tr></thead>
    <tbody>
      <% const names = { planned: 'ожидается', paid: 'оплачен', overdue: 'просрочен' }; %>
      <% schedule.forEach((r) => { %>
        <tr class="<%= r.status === 'overdue' ? 'row--bad' : r.status === 'paid' ? 'row--done' : '' %>">
          <td><%= r.no %></td><td><%= String(r.due_date).slice(0, 10).split('-').reverse().join('.') %></td><td><%= formatAmount(r.principal) %></td><td><%= formatAmount(r.interest) %></td>
          <td><%= r.penalty ? formatAmount(r.penalty) : '' %></td><td><b><%= formatAmount(r.principal + r.interest + r.penalty) %></b></td><td><%= names[r.status] %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
</section>
<%- include('../../partials/footer') %>
