<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/">Главная</a> &nbsp;›&nbsp; <a href="/loans">Кредиты</a> &nbsp;›&nbsp; Заявка № <%= application.id %></nav>
<h1>Заявка № <%= application.id %></h1>
<section class="tile">
  <% const st = application.status; %>
  <div class="alert alert--<%= st === 'rejected' ? 'error' : st === 'manual_review' ? 'info' : 'success' %>" role="status">
    <% if (st === 'approved') { %>Кредит одобрен. Подпишите договор, чтобы получить деньги.
    <% } else if (st === 'manual_review') { %>Заявка передана кредитному специалисту. Решение появится здесь.
    <% } else if (st === 'rejected') { %>Отказ<%= application.decision_comment ? ': ' + application.decision_comment : '' %>.
    <% } else { %>Договор подписан, кредит выдан.<% } %>
  </div>
  <dl class="facts">
    <div><dt>Кредит</dt><dd><%= application.product_name %></dd></div>
    <div><dt>Сумма</dt><dd><%= formatAmount(application.amount) %> BYN</dd></div>
    <div><dt>Срок</dt><dd><%= application.term_months %> мес.</dd></div>
    <div><dt>Ставка</dt><dd><%= String(Number(application.rate_percent)).replace('.', ',') %>% годовых</dd></div>
    <div><dt>Платежи</dt><dd><%= application.schedule_type === 'annuity' ? 'аннуитетные' : 'дифференцированные' %></dd></div>
    <div><dt>Первый платёж</dt><dd><%= formatAmount(application.first_payment) %> BYN</dd></div>
    <div><dt>Долговая нагрузка</dt><dd><%= String(Number(application.dti_percent)).replace('.', ',') %>%</dd></div>
    <div><dt>Скоринговый балл</dt><dd><%= application.score %> из 100</dd></div>
  </dl>
  <% if (st === 'approved') { %>
    <p class="muted measure">Условия на одной странице: сумма <%= formatAmount(application.amount) %> BYN, ставка <%= String(Number(application.rate_percent)).replace('.', ',') %>% годовых, срок <%= application.term_months %> мес., первый платёж <%= formatAmount(application.first_payment) %> BYN. Платежи списываются со счёта зачисления в дату платежа. Договор подписывается кодом из SMS.</p>
    <form class="form w420" method="post" action="/loans/applications/<%= application.id %>/sign">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="code">Код из SMS</label><input class="otp-input" id="code" name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code"></div>
      <% if (demoCode) { %><div class="alert alert--info">Учебная версия: код вместо SMS: <b><%= demoCode %></b></div><% } %>
      <% if (error) { %><div class="alert alert--error" role="alert"><%= error %></div><% } %>
      <div class="actions">
        <button class="btn" type="submit">Подписать договор</button>
        <button class="btn btn--ghost" type="submit" formaction="/loans/applications/<%= application.id %>/code">Получить код</button>
      </div>
    </form>
  <% } %>
</section>
<section class="tile">
  <h2 class="mb10">Как посчитан балл</h2>
  <% application.scoring_notes.forEach((n) => { %>
    <div class="account"><div class="account__title"><%= n.factor %></div><div><span class="muted2"><%= n.text %></span> &nbsp; <b><%= n.points %></b></div></div>
  <% }) %>
</section>
<%- include('../../partials/footer') %>
