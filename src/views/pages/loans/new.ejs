<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/">Главная</a> &nbsp;›&nbsp; <a href="/loans">Кредиты</a> &nbsp;›&nbsp; Заявка</nav>
<% const err = (n) => errors[n] ? `<span class="field__error">${esc(errors[n])}</span>` : ''; const cls = (n) => errors[n] ? ' field--error' : ''; %>
<% const minA = Math.round(Number(product.min_amount) / 100), maxA = Math.round(Number(product.max_amount) / 100); %>
<% const rateTxt = String(Number(product.rate_percent)).replace('.', ','); %>
<section class="loan">
  <div class="loan__main">
    <div>
      <h1><%= product.name.startsWith('Кредит') ? product.name : 'Кредит ' + product.name %></h1>
      <ul class="loan__terms">
        <li>Ставка <%= rateTxt %>% годовых</li>
        <li>От <%= formatAmount(product.min_amount) %> до <%= formatAmount(product.max_amount) %> BYN на срок до <%= product.max_term %> мес.</li>
        <li>Решение по скорингу сразу после отправки заявки</li>
      </ul>
    </div>
    <form class="loan__form" method="post" action="/loans" novalidate id="loan-form" data-product="<%= product.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <% if (errors.common) { %><div class="alert alert--error" role="alert"><%= errors.common %></div><% } %>
      <div class="field<%= cls('amount') %>">
        <div class="field__row"><label for="amount">Сумма кредита, BYN</label></div>
        <input id="amount" name="amount" value="<%= form.amount || '15 000,00' %>" inputmode="decimal" placeholder="От <%= formatAmount(product.min_amount) %>">
        <input class="range" id="amount-range" type="range" min="<%= minA %>" max="<%= maxA %>" step="100" value="15000" aria-label="Сумма кредита ползунком">
        <div class="range__scale"><span><%= minA.toLocaleString('ru-RU') %></span><span><%= maxA.toLocaleString('ru-RU') %></span></div>
        <%- err('amount') %>
      </div>
      <div class="field<%= cls('termMonths') %>">
        <div class="field__row"><label for="termMonths">Срок, месяцев</label></div>
        <input id="termMonths" name="termMonths" type="number" min="<%= product.min_term %>" max="<%= product.max_term %>" value="<%= form.termMonths || 36 %>">
        <input class="range" id="term-range" type="range" min="<%= product.min_term %>" max="<%= product.max_term %>" step="1" value="36" aria-label="Срок ползунком">
        <div class="range__scale"><span><%= product.min_term %> мес.</span><span><%= product.max_term %> мес.</span></div>
        <%- err('termMonths') %>
      </div>
      <div class="loan__pair">
        <fieldset class="seg">
          <legend>Схема платежей</legend>
          <div class="seg__in">
          <label><input type="radio" name="scheduleType" value="annuity"<%= form.scheduleType !== 'differentiated' ? ' checked' : '' %>><span>Аннуитетная</span></label>
          <label><input type="radio" name="scheduleType" value="differentiated"<%= form.scheduleType === 'differentiated' ? ' checked' : '' %>><span>Дифференцированная</span></label>
          </div>
        </fieldset>
        <div class="field<%= cls('targetAccountId') %>"><label for="targetAccountId">Зачислить на счёт</label>
          <select id="targetAccountId" name="targetAccountId"><% accounts.forEach((a) => { %><option value="<%= a.id %>"<%= String(form.targetAccountId) === String(a.id) ? ' selected' : '' %>><%= a.title %>, <%= formatAmount(a.balance) %> BYN</option><% }) %></select><%- err('targetAccountId') %></div>
      </div>
      <h2 class="loan__sub">О вас</h2>
      <div class="form-grid">
        <div class="field<%= cls('income') %>"><label for="income">Доход в месяц, BYN</label><input id="income" name="income" value="<%= form.income || '' %>" inputmode="decimal"><%- err('income') %></div>
        <div class="field<%= cls('obligations') %>"><label for="obligations">Платежи по другим кредитам в месяц, BYN</label><input id="obligations" name="obligations" value="<%= form.obligations || '' %>" inputmode="decimal" placeholder="0"><%- err('obligations') %></div>
        <div class="field<%= cls('experienceMonths') %>"><label for="experienceMonths">Стаж на текущем месте, месяцев</label><input id="experienceMonths" name="experienceMonths" type="number" min="0" value="<%= form.experienceMonths || '' %>"><%- err('experienceMonths') %></div>
        <div class="field<%= cls('dependents') %>"><label for="dependents">Иждивенцев</label><input id="dependents" name="dependents" type="number" min="0" value="<%= form.dependents || 0 %>"><%- err('dependents') %></div>
      </div>
    </form>
  </div>
  <aside class="talon" aria-live="polite">
    <div class="talon__edge talon__edge--top"></div>
    <div class="talon__body">
      <div class="talon__head"><img src="/img/emblem.png" alt="" width="30" height="30"><span>Предварительный расчёт</span></div>
      <div>
        <div class="muted" id="loan-pmt-label">Платёж в месяц</div>
        <div class="talon__sum"><span id="loan-pmt">—</span> <small>BYN</small></div>
      </div>
      <div class="talon__cut"></div>
      <div class="talon__rows">
        <div><span class="muted">Ставка</span><b><%= rateTxt %>% годовых</b></div>
        <div><span class="muted">Переплата</span><b id="loan-over">—</b></div>
        <div><span class="muted">Всего к возврату</span><b id="loan-total">—</b></div>
      </div>
      <p class="talon__ratio" id="loan-ratio"></p>
      <button class="btn btn--lg" type="submit" form="loan-form">Отправить заявку</button>
      <div class="talon__fine">Если заявку одобрит скоринг, договор подписывается кодом на следующем шаге.</div>
    </div>
    <div class="talon__edge talon__edge--bottom"></div>
  </aside>
</section>
<section class="panel loan__schedule" aria-live="polite">
  <div class="loan__schedule-head"><h2>График платежей</h2><span class="muted2" id="loan-count"></span></div>
  <div class="facts" id="loan-summary" hidden></div>
  <div class="scroll-x"><table class="table" id="loan-table" hidden>
    <thead><tr><th>№</th><th>Дата</th><th>Долг</th><th>Проценты</th><th>Платёж</th><th>Остаток</th></tr></thead><tbody></tbody></table></div>
  <button class="link-btn" type="button" id="loan-more" hidden>Показать весь график</button>
  <p class="muted2 m0" id="loan-hint">Введите сумму и срок, график появится здесь.</p>
</section>
<script src="/js/loan-calc.js" defer></script>
<%- include('../../partials/footer') %>
