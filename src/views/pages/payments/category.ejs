<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/cabinet">Главная</a> &nbsp;›&nbsp; <a href="/payments/catalog">Платежи</a> &nbsp;›&nbsp; <%= category.name %></nav>
<section class="pay-banner">
  <div><h1><%= category.name %></h1><div class="muted2"><%= providers.length %> <%= providers.length % 10 === 1 && providers.length % 100 !== 11 ? 'услуга' : ([2, 3, 4].includes(providers.length % 10) && ![12, 13, 14].includes(providers.length % 100)) ? 'услуги' : 'услуг' %></div></div>
  <img src="/img/3d/<%= category.icon %>.png" alt="">
</section>
<section class="panel pay-found">
  <% if (!providers.length) { %><div class="pay-empty">В этой категории пока нет организаций.</div><% } %>
  <% providers.forEach((p) => { %>
    <a class="pay-row pay-row--icon" href="/payments/pay/<%= p.id %>">
      <span class="pay-row__thumb"><img src="/img/3d/<%= category.icon %>.png" alt=""></span>
      <span class="pay-row__txt"><b><%= p.name %></b><small><%= p.requisite_label %><%= p.city ? ', ' + p.city : '' %><%= Number(p.fee_percent) > 0 ? ', комиссия ' + String(Number(p.fee_percent)).replace('.', ',') + '%' : '' %></small></span>
      <span class="pay-row__go">→</span>
    </a>
  <% }) %>
</section>
<%- include('../../partials/footer') %>
