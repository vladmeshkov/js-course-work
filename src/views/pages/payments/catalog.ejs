<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/cabinet">Главная</a> &nbsp;›&nbsp; Платежи</nav>
<div class="pay-head">
  <h1>Оплата услуг</h1>
  <form class="pay-search" method="get" action="/payments/catalog" role="search">
    <label for="find">Найти услугу</label>
    <input id="find" name="q" value="<%= q %>" placeholder="Квартплата, МТС, налог" autocomplete="off">
  </form>
</div>
<% if (q) { %>
  <section class="panel pay-found">
    <% found.forEach((p) => { %>
      <a class="pay-row" href="/payments/pay/<%= p.id %>"><span><b><%= p.name %></b><small><%= p.category_name %></small></span><span class="pay-row__go">→</span></a>
    <% }) %>
    <% if (!found.length) { %><div class="pay-empty">Такой услуги нет в каталоге. Попробуйте другое слово.</div><% } %>
  </section>
<% } else { %>
<section class="cat-grid">
  <% categories.forEach((c, i) => { %>
    <a class="cat-tile cat-tile--<%= i + 1 %>" href="/payments/catalog/<%= c.id %>">
      <span class="cat-tile__name"><%= c.name %></span>
      <span class="cat-tile__hint"><%= c.count %> <%= c.count % 10 === 1 && c.count % 100 !== 11 ? 'услуга' : ([2, 3, 4].includes(c.count % 10) && ![12, 13, 14].includes(c.count % 100)) ? 'услуги' : 'услуг' %></span>
      <img src="/img/3d/<%= c.icon %>.png" alt="" loading="lazy">
    </a>
  <% }) %>
</section>
<section class="pay-two">
  <div class="panel pay-two__pop">
    <h2>Популярное</h2>
    <div class="chips">
      <% popular.forEach((p) => { %><a class="chip" href="/payments/pay/<%= p.id %>"><%= p.name %></a><% }) %>
    </div>
  </div>
  <div class="panel pay-two__tpl">
    <h2>Шаблоны и автоплатежи</h2>
    <% if (!templates.length) { %><p class="muted m0">Сохраните платёж как шаблон при оплате, и он появится здесь.</p><% } %>
    <% templates.forEach((t) => { const auto = autopayments.find((a) => a.template_id === t.id); %>
      <a class="tpl-row" href="/payments/pay/<%= t.provider_id %>?template=<%= t.id %>">
        <span><b><%= t.name %></b><small><%= t.requisite_label %> <%= t.requisite %><%= auto ? ', автоплатёж каждое ' + auto.day_of_month + '-е число' : '' %></small></span>
        <b><%= t.amount ? formatAmount(t.amount) + ' BYN' : '' %></b>
      </a>
    <% }) %>
    <a class="link" href="/payments">Управлять шаблонами</a>
  </div>
</section>
<% } %>
<%- include('../../partials/footer') %>
