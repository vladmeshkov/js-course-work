<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/cabinet">Главная</a> &nbsp;›&nbsp; <a href="/cards">Карты</a> &nbsp;›&nbsp; Выпуск</nav>
<h1>Выпустить карту</h1>
<form class="tile form w640" method="post" action="/cards" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (errors.common) { %><div class="alert alert--error" role="alert"><%= errors.common %></div><% } %>
  <div class="field<%= errors.system ? ' field--error' : '' %>"><label for="system">Платёжная система</label>
    <select id="system" name="system"><% Object.entries(systems).forEach(([k, v]) => { %><option value="<%= k %>"<%= form.system === k ? ' selected' : '' %>><%= v %></option><% }) %></select>
    <% if (errors.system) { %><span class="field__error"><%= errors.system %></span><% } %></div>
  <div class="field<%= errors.accountId ? ' field--error' : '' %>"><label for="accountId">Привязать к счёту</label>
    <select id="accountId" name="accountId"><% accounts.forEach((a) => { %><option value="<%= a.id %>"<%= String(form.accountId) === String(a.id) ? ' selected' : '' %>><%= a.title %>, <%= formatAmount(a.balance) %> <%= a.currency %></option><% }) %></select>
    <% if (errors.accountId) { %><span class="field__error"><%= errors.accountId %></span><% } %></div>
  <div class="field<%= errors.pin ? ' field--error' : '' %>"><label for="pin">PIN-код (4 цифры)</label>
    <input id="pin" name="pin" type="password" inputmode="numeric" maxlength="4" autocomplete="new-password"><% if (errors.pin) { %><span class="field__error"><%= errors.pin %></span><% } %></div>
  <p class="muted2 m0 small">Номер карты и CVV будут показаны один раз после выпуска. В базе хранится только зашифрованный номер и хэши PIN и CVV.</p>
  <div><button class="btn btn--lg" type="submit">Выпустить</button></div>
</form>
<%- include('../../partials/footer') %>
