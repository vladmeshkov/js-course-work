<%- include('../../partials/header', { title }) %>
<h1>Пользователи</h1>
<form class="tile search" method="get" action="/admin/users" role="search">
  <input name="q" value="<%= q %>" placeholder="Логин" aria-label="Поиск по логину">
  <select name="role" aria-label="Роль"><option value="">Все роли</option><% roles.forEach((r) => { %><option value="<%= r.code %>"<%= r.code === role ? ' selected' : '' %>><%= r.name %></option><% }) %></select>
  <button class="btn" type="submit">Найти</button>
</form>
<section class="tile">
  <% if (!users.length) { %><p class="muted m0">Никого не нашли.</p><% } %>
  <% users.forEach((u) => { %>
    <div class="account">
      <div><div class="account__title"><%= u.login %><%= u.last_name ? ' · ' + u.last_name + ' ' + u.first_name : '' %></div>
        <div class="account__iban"><%= u.role_name %>, <%= u.last_login_at ? 'вход ' + new Date(u.last_login_at).toISOString().slice(0, 16).replace('T', ' ') : 'не входил' %></div></div>
      <div class="actions">
        <span class="<%= u.status === 'active' ? 'text-good' : 'text-bad' %>"><%= u.status === 'active' ? 'Активен' : 'Заблокирован' %></span>
        <% if (u.id !== user.id) { %>
          <form method="post" action="/admin/users/<%= u.id %>/block"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--ghost btn--small" type="submit" name="action" value="<%= u.status === 'active' ? 'block' : 'unblock' %>"><%= u.status === 'active' ? 'Заблокировать' : 'Разблокировать' %></button></form>
          <% if (u.role_code !== 'client') { %>
          <form class="actions" method="post" action="/admin/users/<%= u.id %>/role"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select class="mini mini--wide" name="roleCode" aria-label="Роль"><% roles.filter((r) => r.code !== 'client').forEach((r) => { %><option value="<%= r.code %>"<%= r.code === u.role_code ? ' selected' : '' %>><%= r.name %></option><% }) %></select>
            <button class="link-button" type="submit">Сменить</button></form>
          <% } %>
        <% } else { %><span class="muted2">это вы</span><% } %>
      </div>
    </div>
  <% }) %>
</section>
<form class="tile form w640" method="post" action="/admin/users" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2>Добавить сотрудника</h2>
  <div class="field<%= errors.login ? ' field--error' : '' %>"><label for="login">Логин</label><input id="login" name="login" value="<%= form.login || '' %>" autocomplete="off"><% if (errors.login) { %><span class="field__error"><%= errors.login %></span><% } %></div>
  <div class="field<%= errors.password ? ' field--error' : '' %>"><label for="password">Пароль</label><input id="password" name="password" type="password" autocomplete="new-password"><% if (errors.password) { %><span class="field__error"><%= errors.password %></span><% } %></div>
  <div class="field<%= errors.roleCode ? ' field--error' : '' %>"><label for="roleCode">Роль</label><select id="roleCode" name="roleCode"><% roles.filter((r) => r.code !== 'client').forEach((r) => { %><option value="<%= r.code %>"<%= form.roleCode === r.code ? ' selected' : '' %>><%= r.name %></option><% }) %></select><% if (errors.roleCode) { %><span class="field__error"><%= errors.roleCode %></span><% } %></div>
  <div><button class="btn" type="submit">Добавить</button></div>
</form>
<%- include('../../partials/footer') %>
