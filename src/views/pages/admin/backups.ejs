<%- include('../../partials/header', { title }) %>
<div class="between"><h1>Резервные копии</h1>
  <form method="post" action="/admin/backups"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Создать копию</button></form></div>
<section class="tile">
  <p class="muted m0 mb10">Копия делается утилитой pg_dump и шифруется ключом DATA_KEY. Автоматически создаётся по расписанию из настроек сервера.</p>
  <% if (!backups.length) { %><p class="muted m0">Копий пока нет.</p><% } %>
  <% backups.forEach((b) => { %>
    <div class="account">
      <div><div class="account__title"><%= b.name %></div><div class="account__iban"><%= new Date(b.createdAt).toISOString().slice(0, 16).replace('T', ' ') %>, <%= Math.max(1, Math.round(b.size / 1024)) %> КБ</div></div>
      <form class="actions" method="post" action="/admin/backups/restore"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="name" value="<%= b.name %>">
        <input class="mini mini--wide" name="confirm" placeholder="Слово ВОССТАНОВИТЬ" aria-label="Подтверждение восстановления" autocomplete="off">
        <button class="btn btn--ghost btn--small text-bad" type="submit">Восстановить</button></form>
    </div>
  <% }) %>
  <div class="alert alert--info mt10">Восстановление заменяет все текущие данные данными из копии. Действие необратимо, перед ним создайте свежую копию.</div>
</section>
<%- include('../../partials/footer') %>
