<%- include('../../partials/header', { title }) %>
<div class="between"><h1>Курсы и тарифы</h1>
  <form method="post" action="/admin/rates/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost" type="submit">Обновить курсы с Нацбанка</button></form></div>
<form class="panel" method="post" action="/admin/rates/spreads" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2 class="mb10">Спред банка к курсу Нацбанка</h2>
  <div class="scroll-x"><table class="table">
    <thead><tr><th>Валюта</th><th>Курс НБ РБ</th><th>Банк покупает, %</th><th>Банк продаёт, %</th><th>Курс покупки</th><th>Курс продажи</th></tr></thead>
    <tbody>
      <% spreads.forEach((s) => { const unit = s.rate === null ? null : s.rate / s.scale; %>
        <tr>
          <td><div class="cur-cell"><%- include('../../partials/flag', { code: s.currency.toLowerCase(), w: 34 }) %><b><%= s.currency %></b><% if (s.scale > 1) { %> <span class="muted2">за <%= s.scale %></span><% } %></div></td>
          <td><%= s.rate === null ? '—' : String(s.rate).replace('.', ',') %></td>
          <td><input class="mini" name="<%= s.currency %>_buy" value="<%= String(s.buy_percent).replace('.', ',') %>" aria-label="Спред покупки <%= s.currency %>"><% if (errors[s.currency + '_buy']) { %><div class="field__error"><%= errors[s.currency + '_buy'] %></div><% } %></td>
          <td><input class="mini" name="<%= s.currency %>_sell" value="<%= String(s.sell_percent).replace('.', ',') %>" aria-label="Спред продажи <%= s.currency %>"><% if (errors[s.currency + '_sell']) { %><div class="field__error"><%= errors[s.currency + '_sell'] %></div><% } %></td>
          <td><%= unit === null ? '—' : (unit * s.scale * (1 - s.buy_percent / 100)).toFixed(4).replace('.', ',') %></td>
          <td><%= unit === null ? '—' : (unit * s.scale * (1 + s.sell_percent / 100)).toFixed(4).replace('.', ',') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <div class="mt10"><button class="btn" type="submit">Сохранить спред</button></div>
</form>
<form class="panel form" method="post" action="/admin/rates/settings" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% groups.forEach((g) => { %>
    <h2><%= g.name %></h2>
    <% g.items.forEach((it) => { %>
      <div class="setting<%= errors[it.key] ? ' field--error' : '' %>">
        <label for="s-<%= it.key %>"><%= it.label %></label>
        <span class="setting__input"><input id="s-<%= it.key %>" name="<%= it.key %>" value="<%= it.value %>" inputmode="decimal"><span class="muted"><%= it.unit %></span></span>
        <% if (errors[it.key]) { %><span class="field__error"><%= errors[it.key] %></span><% } %>
      </div>
    <% }) %>
  <% }) %>
  <div><button class="btn" type="submit">Сохранить тарифы</button></div>
</form>
<%- include('../../partials/footer') %>
