<%- include('../../partials/header', { title }) %>
<h1>Операционный день</h1>
<section class="tile form" style="max-width:720px">
  <div><div class="muted2">Текущая банковская дата</div><div class="balance-big"><%= String(bankDate).slice(0, 10) %></div></div>
  <p class="muted" style="margin:0">При закрытии дня банковская дата сдвигается вперёд, начисляются проценты по вкладам, закрываются вклады с наступившим сроком. Для показа можно прокрутить несколько дней.</p>
  <form method="post" action="/admin/eod" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field" style="width:140px"><label for="days">Сколько дней</label><input id="days" name="days" type="number" min="1" max="400" value="1"></div>
    <button class="btn" type="submit">Закрыть день</button>
  </form>
  <div>
    <div class="muted2" style="margin-bottom:6px">Контроль двойной записи (сумма остатков по валютам)</div>
    <% balance.forEach((b) => { %><div><%= b.currency %>: <b style="color:<%= b.ok ? '#1E7B45' : '#B4233C' %>"><%= b.ok ? 'сходится' : 'расхождение ' + b.net %></b></div><% }) %>
  </div>
</section>
<%- include('../../partials/footer') %>
