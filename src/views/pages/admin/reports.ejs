<%- include('../../partials/header', { title }) %>
<h1>Отчёты</h1>
<form class="tile search" method="get" action="/admin/reports">
  <label class="muted2" for="from">С</label><input id="from" name="from" type="date" value="<%= trial.from %>">
  <label class="muted2" for="to">По</label><input id="to" name="to" type="date" value="<%= trial.to %>">
  <select name="currency" aria-label="Валюта"><% ['BYN', 'USD', 'EUR', 'RUB'].forEach((c) => { %><option<%= c === currency ? ' selected' : '' %>><%= c %></option><% }) %></select>
  <button class="btn" type="submit">Показать</button>
  <a class="btn btn--ghost" href="/admin/reports/trial.csv?from=<%= trial.from %>&to=<%= trial.to %>&currency=<%= currency %>">Скачать CSV</a>
  <% if (errors.from) { %><span class="field__error"><%= errors.from %></span><% } %>
</form>
<section class="tile">
  <h2 class="mb10">Оборотно-сальдовая ведомость, <%= currency %></h2>
  <div class="scroll-x"><table class="table table--num">
    <thead><tr><th>Счёт</th><th>Название</th><th>Остаток на начало</th><th>Оборот Дт</th><th>Оборот Кт</th><th>Остаток на конец</th></tr></thead>
    <tbody>
      <% trial.lines.forEach((l) => { %><tr><td><%= l.code %></td><td><%= l.name %></td><td><%= formatAmount(l.opening) %></td><td><%= formatAmount(l.debit) %></td><td><%= formatAmount(l.credit) %></td><td><%= formatAmount(l.closing) %></td></tr><% }) %>
      <tr class="row--total"><td></td><td>Итого</td><td><%= formatAmount(trial.total.opening) %></td><td><%= formatAmount(trial.total.debit) %></td><td><%= formatAmount(trial.total.credit) %></td><td><%= formatAmount(trial.total.closing) %></td></tr>
    </tbody>
  </table></div>
  <p class="mt10 m0 <%= trial.balanced ? 'text-good' : 'text-bad' %>"><b><%= trial.balanced ? 'Ведомость сходится: обороты по Дт равны оборотам по Кт.' : 'Ведомость не сходится, нужна проверка проводок.' %></b></p>
  <p class="muted2 small m0">Остаток = обороты по Кт минус обороты по Дт. Дебетовое сальдо (касса, ссуды) показано отрицательным числом.</p>
</section>
<section class="row">
  <div class="tile grow">
    <h2 class="mb10">Кредитный портфель</h2>
    <dl class="facts"><div><dt>Действующих кредитов</dt><dd><%= portfolio.loans.count %></dd></div><div><dt>Основной долг</dt><dd><%= formatAmount(portfolio.loans.principal) %> BYN</dd></div>
      <div><dt>Просроченный долг</dt><dd><%= formatAmount(portfolio.loans.overduePrincipal) %> BYN</dd></div><div><dt>Доля просрочки</dt><dd><%= String(portfolio.loans.overdueShare).replace('.', ',') %>%</dd></div></dl>
    <% portfolio.loans.buckets.forEach((b) => { %><div class="account"><div class="account__title"><%= b.name %></div><div><span class="muted2"><%= b.count %> кред.</span> &nbsp; <b><%= formatAmount(b.principal) %></b></div></div><% }) %>
  </div>
  <div class="tile grow">
    <h2 class="mb10">Вклады</h2>
    <% if (!portfolio.deposits.length) { %><p class="muted m0">Действующих вкладов нет.</p><% } %>
    <% portfolio.deposits.forEach((d) => { %><div class="account"><div class="account__title"><%= d.count %> вкл., <%= d.currency %></div><div class="amount"><%= formatAmount(d.total) %> <small><%= d.currency %></small></div></div><% }) %>
    <h2 class="mb10 mt10">Доходы и расходы</h2>
    <% portfolio.income.forEach((i) => { %><div class="account"><div class="account__title">Доходы, <%= i.currency %></div><div class="amount text-good"><%= formatAmount(i.amount) %></div></div><% }) %>
    <% portfolio.expense.forEach((i) => { %><div class="account"><div class="account__title">Расходы (проценты по вкладам), <%= i.currency %></div><div class="amount"><%= formatAmount(i.amount) %></div></div><% }) %>
  </div>
</section>
<section class="tile">
  <h2 class="mb10">Операции за 30 дней</h2>
  <% portfolio.operations.byType.forEach((t) => { %><div class="account"><div class="account__title"><%= t.type %></div><div><span class="muted2"><%= t.count %> шт.</span> &nbsp; <b><%= formatAmount(t.byn) %> BYN</b></div></div><% }) %>
</section>
<%- include('../../partials/footer') %>
