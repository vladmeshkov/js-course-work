<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/">Главная</a> &nbsp;›&nbsp; <a href="/deposits">Вклады</a> &nbsp;›&nbsp; Открыть вклад</nav>
<h1>Открыть вклад</h1>
<section class="dep">
  <div class="dep__main">
    <div class="dep__block">
      <h2>Выберите вклад</h2>
      <% products.forEach((p) => { %>
        <a class="dep__prod" href="/deposits/new?product=<%= p.id %>"<%- p.id === product.id ? ' aria-current="true"' : '' %>>
          <span><span class="dep__name">«<%= p.name %>»</span><span class="dep__note"><%= p.term_months %> мес., от <%= formatAmount(p.min_amount) %> <%= p.currency %>. <%= p.capitalization ? 'Проценты прибавляются к вкладу' : 'Проценты выплачиваются на счёт' %></span></span>
          <span class="dep__rate"><%= String(Number(p.rate_percent)).replace('.', ',') %>%</span>
        </a>
      <% }) %>
    </div>
    <form class="dep__form" id="dep-form" method="post" action="/deposits" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <% if (errors.common) { %><div class="alert alert--error" role="alert"><%= errors.common %></div><% } %>
      <div class="field<%= errors.sourceAccountId ? ' field--error' : '' %>">
        <label for="sourceAccountId">Списать со счёта</label>
        <select id="sourceAccountId" name="sourceAccountId">
          <% accounts.forEach((a) => { %><option value="<%= a.id %>"<%= String(form.sourceAccountId) === String(a.id) ? ' selected' : '' %>><%= a.title %>, <%= formatAmount(a.balance) %> <%= a.currency %></option><% }) %>
        </select>
        <% if (!accounts.length) { %><span class="field__hint">Нет счёта в валюте <%= product.currency %>. Сначала откройте такой счёт.</span><% } %>
        <% if (errors.sourceAccountId) { %><span class="field__error"><%= errors.sourceAccountId %></span><% } %>
      </div>
      <div class="field<%= errors.amount ? ' field--error' : '' %>">
        <label for="amount">Сумма вклада, <%= product.currency %></label>
        <input id="amount" name="amount" value="<%= form.amount || formatAmount(Math.max(Number(product.min_amount), 400000)) %>" inputmode="decimal" autocomplete="off" placeholder="От <%= formatAmount(product.min_amount) %>" data-product="<%= product.id %>">
        <input class="range" id="amount-range" type="range" min="<%= Math.round(Number(product.min_amount) / 100) %>" max="50000" step="100" value="<%= Math.round(Number(product.min_amount) / 100) %>" aria-label="Сумма вклада ползунком">
        <div class="range__scale"><span><%= Math.round(Number(product.min_amount) / 100) %></span><span>50 000</span></div>
        <% if (errors.amount) { %><span class="field__error"><%= errors.amount %></span><% } %>
      </div>
    </form>
    <div>
      <div class="dep__bar" aria-hidden="true"><div class="dep__bar-main" id="dep-bar"></div><div class="dep__bar-income"></div></div>
      <div class="dep__bar-caption"><span class="muted">Вы вложите <span id="dep-sum">—</span></span><b id="dep-income-cap">Доход —</b></div>
    </div>
  </div>
  <aside class="dep__aside" aria-live="polite">
    <div class="dep__aside-lead">К получению через <%= product.term_months %> мес.</div>
    <div class="dep__total" id="calc-total">—</div>
    <div class="dep__facts">
      <div><span>Ставка</span><span><%= String(Number(product.rate_percent)).replace('.', ',') %>% годовых</span></div>
      <div><span>Доход за срок</span><span id="calc-income">—</span></div>
      <div><span>Проценты</span><span><%= product.capitalization ? 'капитализация' : 'на счёт' %></span></div>
    </div>
    <p class="dep__aside-note"><%= product.revocable ? 'При досрочном закрытии проценты пересчитываются по сниженной ставке.' : 'Досрочное закрытие по этому вкладу невозможно.' %></p>
    <button class="btn btn--lg" type="submit" form="dep-form"<%= accounts.length ? '' : ' disabled' %>>Открыть вклад</button>
  </aside>
</section>
<script src="/js/deposit-calc.js" defer></script>
<%- include('../../partials/footer') %>
