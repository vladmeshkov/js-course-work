<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/security">Безопасность</a> &nbsp;›&nbsp; Включение</nav>
<h1>Включить двухфакторную защиту</h1>
<section class="row">
  <div class="tile grow">
    <h2 class="mb10">1. Добавьте аккаунт в приложение</h2>
    <p class="muted">Отсканируйте QR-код приложением-аутентификатором или введите ключ вручную.</p>
    <div class="qr" role="img" aria-label="QR-код для приложения-аутентификатора"><%- setup.qrSvg %></div>
    <p class="small muted2 mt10 m0">Ключ вручную:</p>
    <p class="secret"><%= setup.secret.replace(/(.{4})/g, '$1 ').trim() %></p>
  </div>
  <form class="tile form grow" method="post" action="/security/2fa/setup" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>2. Введите код</h2>
    <p class="muted m0">Приложение покажет шестизначный код. Введите его, чтобы подтвердить настройку.</p>
    <div class="field<%= errors.code ? ' field--error' : '' %>"><label for="code">Код из приложения</label><input id="code" name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" class="otp-input"><% if (errors.code) { %><span class="field__error"><%= errors.code %></span><% } %></div>
    <div><button class="btn btn--lg" type="submit">Включить</button></div>
  </form>
</section>
<%- include('../../partials/footer') %>
