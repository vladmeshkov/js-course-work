<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/cabinet">Главная</a> &nbsp;›&nbsp; <a href="/accounts">Счета и карты</a> &nbsp;›&nbsp; Открыть счёт</nav>
<h1>Открыть счёт</h1>
<form class="tile form w640" method="post" action="/accounts" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (errors.common) { %><div class="alert alert--error" role="alert"><%= errors.common %></div><% } %>
  <div class="field<%= errors.currency ? ' field--error' : '' %>"><label for="currency">Валюта</label>
    <select id="currency" name="currency"><% [['BYN', 'Белорусский рубль'], ['USD', 'Доллар США'], ['EUR', 'Евро'], ['RUB', 'Российский рубль']].forEach(([c, n]) => { %><option value="<%= c %>"<%= form.currency === c ? ' selected' : '' %>><%= c %>, <%= n %></option><% }) %></select>
    <% if (errors.currency) { %><span class="field__error"><%= errors.currency %></span><% } %></div>
  <div class="field<%= errors.kind ? ' field--error' : '' %>"><label for="kind">Вид счёта</label>
    <select id="kind" name="kind"><option value="current"<%= form.kind !== 'savings' ? ' selected' : '' %>>Текущий: платежи, переводы, карты</option><option value="savings"<%= form.kind === 'savings' ? ' selected' : '' %>>Накопительный</option></select>
    <% if (errors.kind) { %><span class="field__error"><%= errors.kind %></span><% } %></div>
  <p class="muted2 m0 small">Номер счёта в формате IBAN Беларуси формируется автоматически, контрольные цифры считаются по стандарту ISO 13616 (mod 97).</p>
  <div><button class="btn btn--lg" type="submit">Открыть счёт</button></div>
</form>
<%- include('../../partials/footer') %>
