<%- include('../../partials/header', { title }) %>
<div class="q-head"><h1>Заявки на кредит</h1><div class="muted"><%= applications.length ? 'В очереди: ' + applications.length : 'Очередь пуста' %></div></div>
<% if (!applications.length) { %><section class="panel"><p class="muted m0">Заявок на рассмотрении нет.</p></section><% } %>
<section class="stubs" aria-label="Очередь заявок">
  <% applications.forEach((a) => { %>
    <a class="stub" href="/staff/loans/<%= a.id %>">
      <span class="stub__top"><span class="muted2">№ <%= a.id %></span><b class="stub__st">на рассмотрении</b></span>
      <span class="stub__name"><%= a.last_name %> <%= a.first_name %></span>
      <span class="stub__sum"><%= formatAmount(a.amount) %> <small>BYN</small></span>
      <span class="stub__meta"><%= a.product_name %>, балл <%= a.score %>, нагрузка <%= String(Number(a.dti_percent)).replace('.', ',') %>%</span>
    </a>
  <% }) %>
</section>
<%- include('../../partials/footer') %>
