<%- include('../../partials/header', { title }) %>
<%
  const a = application;
  const dmy = (v) => String(v).slice(0, 10).split('-').reverse().join('.');
  const pct = (v) => String(Number(v)).replace('.', ',') + '%';
  const sections = [
    ['Заёмщик', [['ФИО', a.last_name + ' ' + a.first_name + ' ' + (a.patronymic || '')], ['Дата рождения', dmy(a.birth_date)]]],
    ['Кредит', [['Продукт', a.product_name], ['Сумма', formatAmount(a.amount) + ' BYN'], ['Срок', a.term_months + ' мес.'], ['Первый платёж', formatAmount(a.first_payment) + ' BYN']]],
    ['Доходы и обязательства', [['Доход в месяц', formatAmount(a.income) + ' BYN'], ['Платежи по другим кредитам', formatAmount(a.obligations) + ' BYN'], ['Стаж', a.experience_months + ' мес.'], ['Иждивенцы', String(a.dependents)], ['Долговая нагрузка', pct(a.dti_percent)]]]
  ];
  const stamp = a.status === 'approved' || a.status === 'signed' ? ['ОДОБРЕНО', 'ok'] : a.status === 'rejected' ? ['ОТКАЗ', 'bad'] : null;
%>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/staff/loans">Заявки на кредит</a> &nbsp;›&nbsp; № <%= a.id %></nav>
<section class="review">
  <article class="paper" aria-label="Анкета заёмщика">
    <div class="paper__head"><h1>Анкета заёмщика</h1><span class="muted">№ <%= a.id %></span></div>
    <% sections.forEach((sec) => { %>
      <div class="paper__sec">
        <h3><%= sec[0] %></h3>
        <% sec[1].forEach((r) => { %><div class="dots"><span class="muted"><%= r[0] %></span><i></i><b><%= r[1] %></b></div><% }) %>
      </div>
    <% }) %>
    <% if (stamp) { %><div class="paper__stamp paper__stamp--<%= stamp[1] %>"><%= stamp[0] %></div><% } %>
  </article>
  <aside class="review__side">
    <div>
      <h2>Проверки</h2>
      <% if (a.model_version) { %>
        <div class="check-row"><span>Вероятность дефолта<small>регрессионная модель версии <%= a.model_version %></small></span><b><%= String(Number(a.pd_percent)).replace('.', ',') %> %</b></div>
        <% a.scoring_notes.slice(1).forEach((n) => { %><div class="check-row"><span><%= n.factor %><small><%= n.text %></small></span><b class="<%= n.points > 0 ? 'text-bad' : n.points < 0 ? 'text-good' : '' %>"><%= (n.points > 0 ? '+' : '') + String(n.points).replace('.', ',') %> п.п.</b></div><% }) %>
        <p class="muted2 small m0">Вклад признака: на сколько процентных пунктов он меняет вероятность дефолта относительно среднего заёмщика.</p>
      <% } else { %>
        <div class="check-row"><span>Скоринговый балл</span><b><%= a.score %> из 100</b></div>
        <% a.scoring_notes.forEach((n) => { %><div class="check-row"><span><%= n.factor %><small><%= n.text %></small></span><b><%= n.points %></b></div><% }) %>
      <% } %>
    </div>
    <% if (a.status === 'manual_review') { %>
    <form class="panel form" method="post" action="/staff/loans/<%= a.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2>Решение</h2>
      <div class="field<%= errors.comment ? ' field--error' : '' %>"><label for="comment">Комментарий (обязателен при отказе)</label><textarea id="comment" name="comment" rows="3"></textarea><% if (errors.comment) { %><span class="field__error"><%= errors.comment %></span><% } %></div>
      <div class="actions actions--tight"><button class="btn" type="submit" name="decision" value="approve">Одобрить</button><button class="btn btn--ghost btn--danger" type="submit" name="decision" value="reject">Отказать</button></div>
    </form>
    <% } else { %><div class="alert alert--info">Заявка уже рассмотрена.</div><% } %>
  </aside>
</section>
<%- include('../../partials/footer') %>
