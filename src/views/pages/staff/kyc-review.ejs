<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/staff/kyc">Анкеты клиентов</a> &nbsp;›&nbsp; <%= client.last_name %></nav>
<h1><%= client.last_name %> <%= client.first_name %> <%= client.patronymic || '' %></h1>
<section class="tile">
  <dl class="facts">
    <div><dt>Логин</dt><dd><%= client.login %></dd></div>
    <div><dt>Дата рождения</dt><dd><%= String(client.birth_date).slice(0, 10) %></dd></div>
    <div><dt>Телефон</dt><dd><%= client.phone %></dd></div>
    <div><dt>Почта</dt><dd><%= client.email || '—' %></dd></div>
    <div><dt>Идентификационный номер</dt><dd><%= client.idNumber %></dd></div>
    <div><dt>Паспорт</dt><dd><%= client.passport %></dd></div>
  </dl>
  <p class="muted2 small m0">Данные хранятся зашифрованными, факт просмотра записан в журнал аудита.</p>
</section>
<% if (client.kyc_status === 'submitted') { %>
<form class="tile form w720" method="post" action="/staff/kyc/<%= client.id %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2>Решение</h2>
  <div class="field<%= errors.comment ? ' field--error' : '' %>"><label for="comment">Комментарий (обязателен при отказе)</label><input id="comment" name="comment"><% if (errors.comment) { %><span class="field__error"><%= errors.comment %></span><% } %></div>
  <div class="actions"><button class="btn" type="submit" name="decision" value="approve">Подтвердить и открыть счёт</button><button class="btn btn--ghost" type="submit" name="decision" value="reject">Отклонить</button></div>
</form>
<% } else { %><div class="alert alert--info">Анкета уже рассмотрена.</div><% } %>
<%- include('../../partials/footer') %>
