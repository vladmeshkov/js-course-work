<%- include('../../partials/header', { title }) %>
<h1>Антифрод</h1>
<section class="tile">
  <h2 class="mb10">Очередь на проверку</h2>
  <% if (!cases.length) { %><p class="muted m0">Задержанных переводов нет.</p><% } %>
  <% cases.forEach((c) => { %>
    <a class="account" href="/staff/fraud/<%= c.id %>"><div><div class="account__title"><%= c.login %>: <%= formatAmount(c.amount) %> <%= c.currency %></div><div class="account__iban">случай № <%= c.id %>, риск <%= c.score %> баллов<%= c.special_control ? ', особый контроль' : '' %></div></div><span class="link">Рассмотреть &nbsp;→</span></a>
  <% }) %>
</section>
<section class="tile">
  <h2 class="mb10">Операции особого контроля</h2>
  <p class="muted2 small mb10">Переводы на сумму не ниже порога по Закону № 165-З (порог задаётся в настройках).</p>
  <% if (!special.length) { %><p class="muted m0">Таких операций пока нет.</p><% } %>
  <% special.forEach((c) => { %>
    <div class="account"><div><div class="account__title"><%= c.login %></div><div class="account__iban"><%= new Date(c.created_at).toISOString().slice(0, 16).replace('T', ' ') %>, случай № <%= c.id %></div></div><div class="amount"><%= formatAmount(c.amount_byn) %> <small>BYN</small></div></div>
  <% }) %>
</section>
<%- include('../../partials/footer') %>
