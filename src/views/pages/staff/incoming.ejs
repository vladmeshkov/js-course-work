<%- include('../../partials/header', { title }) %>
<h1>Входящие платежи</h1>
<form class="tile form w640" method="post" action="/staff/incoming" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <p class="muted m0">Регистрация платежа из другого банка: деньги зачисляются с корреспондентского счёта на счёт клиента.</p>
  <div class="field<%= errors.bankCode ? ' field--error' : '' %>"><label for="bankCode">Банк отправителя</label>
    <select id="bankCode" name="bankCode"><% banks.forEach((b) => { %><option value="<%= b.code %>"<%= form.bankCode === b.code ? ' selected' : '' %>><%= b.name %></option><% }) %></select><% if (errors.bankCode) { %><span class="field__error"><%= errors.bankCode %></span><% } %></div>
  <div class="field<%= errors.name ? ' field--error' : '' %>"><label for="name">Отправитель</label><input id="name" name="name" value="<%= form.name || '' %>"><% if (errors.name) { %><span class="field__error"><%= errors.name %></span><% } %></div>
  <div class="field<%= errors.iban ? ' field--error' : '' %>"><label for="iban">Счёт клиента ТалерБанка (IBAN)</label><input id="iban" name="iban" value="<%= form.iban || '' %>" autocomplete="off"><% if (errors.iban) { %><span class="field__error"><%= errors.iban %></span><% } %></div>
  <div class="field<%= errors.amount ? ' field--error' : '' %>"><label for="amount">Сумма, BYN</label><input id="amount" name="amount" value="<%= form.amount || '' %>" inputmode="decimal"><% if (errors.amount) { %><span class="field__error"><%= errors.amount %></span><% } %></div>
  <div class="field"><label for="purpose">Назначение</label><input id="purpose" name="purpose" value="<%= form.purpose || '' %>"></div>
  <div><button class="btn btn--lg" type="submit">Зачислить</button></div>
</form>
<%- include('../../partials/footer') %>
