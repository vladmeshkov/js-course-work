<%- include('../../partials/header', { title }) %>
<h1>Касса</h1>
<form class="tile form w640" method="post" action="/staff/cash" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (errors.common) { %><div class="alert alert--error" role="alert"><%= errors.common %></div><% } %>
  <div class="field<%= errors.direction ? ' field--error' : '' %>"><label for="direction">Операция</label>
    <select id="direction" name="direction"><option value="in"<%= form.direction !== 'out' ? ' selected' : '' %>>Взнос наличных</option><option value="out"<%= form.direction === 'out' ? ' selected' : '' %>>Выдача наличных</option></select></div>
  <div class="field<%= errors.iban ? ' field--error' : '' %>"><label for="iban">Номер счёта клиента (IBAN)</label><input id="iban" name="iban" value="<%= form.iban || '' %>" autocomplete="off"><% if (errors.iban) { %><span class="field__error"><%= errors.iban %></span><% } %></div>
  <div class="field<%= errors.amount ? ' field--error' : '' %>"><label for="amount">Сумма (в валюте счёта)</label><input id="amount" name="amount" value="<%= form.amount || '' %>" inputmode="decimal"><% if (errors.amount) { %><span class="field__error"><%= errors.amount %></span><% } %></div>
  <div><button class="btn btn--lg" type="submit">Провести</button></div>
</form>
<%- include('../../partials/footer') %>
