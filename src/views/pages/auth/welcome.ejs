<%- include('../../partials/header', { title }) %>
<section class="auth welcome">
  <div class="auth__side">
    <div class="auth__top">
      <a class="logo logo--lg" href="/cabinet"><img src="/img/emblem.png" alt="" width="60" height="60"><span>Талер<span class="logo__bank">Банк</span></span></a>
      <div><h1>С возвращением, <%= name %></h1>
      <p class="auth__lead"><%= previous ? 'Прошлый вход: ' + new Date(previous).toLocaleString('ru-RU', { timeZone: 'Europe/Minsk', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }).replace(',', ' в') + '.' : 'Это ваш первый вход.' %></p></div>
    </div>
    <img class="auth__coin" src="/img/coin.png" alt="" width="540">
  </div>
  <div class="auth__panel">
    <div class="auth__card">
      <div class="fact">
        <div class="fact__lead">Знаете ли вы</div>
        <p class="fact__text" id="fact-text">Первые талеры чеканили с 1518 года в чешском городе Яхимов. От слова «талер» произошло название доллара.</p>
        <button class="fact__more" type="button" id="fact-next">Другой факт</button>
      </div>
      <a class="btn btn--lg welcome__go" href="/cabinet">Перейти в кабинет</a>
    </div>
  </div>
</section>
<script src="/js/welcome.js" defer></script>
<%- include('../../partials/footer') %>
