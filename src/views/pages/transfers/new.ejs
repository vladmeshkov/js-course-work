<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/cabinet">Главная</a> &nbsp;›&nbsp; <a href="/payments">Платежи и переводы</a> &nbsp;›&nbsp; Перевод</nav>
<section class="panel xfer">
<h1 class="xfer__title"><%= kind === 'own' ? 'Перевод между своими счетами' : 'Перевод клиенту банка онлайн' %></h1>
<div class="xfer__perks">
  <% if (kind === 'own') { %><span>Мгновенно</span><span>Конвертация по курсу банка</span><span>Без комиссии</span>
  <% } else { %><span>По номеру счёта в формате IBAN</span><span>Без комиссии внутри банка</span><span>Подтверждение кодом</span><% } %>
</div>
<div class="chips chips--center" role="tablist">
  <a class="chip" role="tab" aria-selected="<%= kind === 'client' %>" href="/transfers/new?kind=client">Клиенту банка</a>
  <a class="chip" role="tab" aria-selected="<%= kind === 'own' %>" href="/transfers/new?kind=own">Между своими счетами</a>
  <a class="chip" role="tab" aria-selected="false" href="/transfers/interbank">В другой банк</a>
</div>
<form class="xfer__form" method="post" action="/transfers" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="kind" value="<%= kind %>">
  <% if (errors.common) { %><div class="alert alert--error" role="alert"><%= errors.common %></div><% } %>
  <% const accountOptions = (selected) => accounts.map((a) => `<option value="${a.id}" data-currency="${a.currency}"${String(selected) === String(a.id) ? ' selected' : ''}>${esc(a.title)}, ${formatAmount(a.balance)} ${a.currency}</option>`).join(''); %>
  <div class="xfer__pair">
    <div class="xfer__side">
      <div><div class="xfer__h">Со счёта</div><div class="muted2">ТалерБанк</div></div>
      <div class="xfer__box<%= errors.fromAccountId ? ' xfer__box--error' : '' %>">
        <label for="fromAccountId">Счёт списания</label>
        <select id="fromAccountId" name="fromAccountId"><%- accountOptions(form.fromAccountId) %></select>
      </div>
      <% if (errors.fromAccountId) { %><span class="field__error"><%= errors.fromAccountId %></span><% } %>
    </div>
    <div class="xfer__side">
      <% if (kind === 'own') { %>
        <div><div class="xfer__h">На счёт</div><div class="muted2">Свой счёт в ТалерБанке</div></div>
        <div class="xfer__box<%= errors.toAccountId ? ' xfer__box--error' : '' %>">
          <label for="toAccountId">Счёт зачисления</label>
          <select id="toAccountId" name="toAccountId"><%- accountOptions(form.toAccountId) %></select>
        </div>
        <% if (errors.toAccountId) { %><span class="field__error"><%= errors.toAccountId %></span><% } %>
        <div class="xfer__hint">Если валюты разные, сумма пересчитается по курсу банка.</div>
      <% } else { %>
        <div><div class="xfer__h">На счёт</div><div class="muted2">Клиента ТалерБанка</div></div>
        <div class="xfer__box<%= errors.toIban ? ' xfer__box--error' : '' %>">
          <label for="toIban">Номер счёта (IBAN)</label>
          <input id="toIban" name="toIban" value="<%= form.toIban || '' %>" autocomplete="off" placeholder="BY00 TLRB 2400 0000 0000 0000 0001">
        </div>
        <% if (errors.toIban) { %><span class="field__error"><%= errors.toIban %></span><% } %>
      <% } %>
    </div>
  </div>
  <div class="xfer__row">
    <div class="xfer__box xfer__box--sum<%= errors.amount ? ' xfer__box--error' : '' %>">
      <label for="amount">Сумма (в валюте счёта списания)</label>
      <input id="amount" name="amount" value="<%= form.amount || '' %>" inputmode="decimal" autocomplete="off" placeholder="0,00">
    </div>
    <div class="xfer__box xfer__box--cur"><div class="xfer__curlabel">Валюта</div><div class="xfer__curval" id="xfer-cur"><%= (accounts.find((a) => String(a.id) === String(form.fromAccountId)) || accounts[0] || {}).currency || 'BYN' %></div></div>
    <div class="xfer__box xfer__box--comment">
      <label for="comment">Назначение платежа</label>
      <input id="comment" name="comment" maxlength="140" value="<%= form.comment || '' %>">
    </div>
  </div>
  <% if (errors.amount) { %><span class="field__error"><%= errors.amount %></span><% } %>
  <div class="xfer__foot">
    <p class="xfer__note">Комиссия и лимит показаны на следующем шаге. Операция подтверждается одноразовым кодом. Если зачисление не удастся, деньги останутся на вашем счёте.</p>
    <button class="btn btn--lg xfer__go" type="submit">Перевести</button>
  </div>
</form>
</section>
<script src="/js/xfer.js" defer></script>
<%- include('../../partials/footer') %>
