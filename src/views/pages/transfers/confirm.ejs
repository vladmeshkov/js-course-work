<%- include('../../partials/header', { title }) %>
<h1>Подтвердите перевод</h1>
<form class="tile form w640" method="post" action="/transfers/<%= intent.id %>/confirm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div>
    <div class="muted2">Сумма</div>
    <div class="balance-big balance-mid"><%= formatAmount(intent.amount) %> <small class="muted unit unit--sm"><%= from.currency %></small></div>
  </div>
  <div class="muted">Со счёта: <%= formatIban(from.iban) %><br>На счёт: <%= formatIban(to.iban) %><% if (intent.fee > 0) { %><br>Комиссия: <%= formatAmount(intent.fee) %> <%= from.currency %><% } %></div>
  <div class="field">
    <label for="code">Код из SMS</label>
    <input class="otp-input" id="code" name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" autofocus>
  </div>
  <% if (demoCode) { %><div class="alert alert--info">Учебная версия: код вместо SMS показан здесь: <b><%= demoCode %></b></div><% } %>
  <% if (error) { %><div class="alert alert--error" role="alert"><%= error %></div><% } %>
  <div class="actions">
    <button class="btn btn--lg" type="submit">Подтвердить</button>
    <button class="link link-button" type="submit" formaction="/transfers/<%= intent.id %>/cancel">Отменить</button>
  </div>
</form>
<%- include('../../partials/footer') %>
