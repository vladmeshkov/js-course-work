<%- include('../../partials/header', { title }) %>
<nav class="crumbs" aria-label="Навигационная цепочка"><a href="/cabinet">Главная</a> &nbsp;›&nbsp; <a href="/payments">Платежи и переводы</a> &nbsp;›&nbsp; В другой банк</nav>
<h1>Перевод в другой банк</h1>
<div class="chips" role="tablist">
  <a class="chip" role="tab" aria-selected="false" href="/transfers/new?kind=client">Клиенту банка</a>
  <a class="chip" role="tab" aria-selected="false" href="/transfers/new?kind=own">Между своими счетами</a>
  <a class="chip" role="tab" aria-selected="true" href="/transfers/interbank">В другой банк</a>
</div>
<form class="tile form w720" method="post" action="/transfers/interbank" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (errors.common) { %><div class="alert alert--error" role="alert"><%= errors.common %></div><% } %>
  <div class="field<%= errors.fromAccountId ? ' field--error' : '' %>"><label for="fromAccountId">Со счёта</label>
    <select id="fromAccountId" name="fromAccountId"><% accounts.forEach((a) => { %><option value="<%= a.id %>"<%= String(form.fromAccountId) === String(a.id) ? ' selected' : '' %>><%= a.title %>, <%= formatAmount(a.balance) %> BYN</option><% }) %></select>
    <% if (errors.fromAccountId) { %><span class="field__error"><%= errors.fromAccountId %></span><% } %></div>
  <div class="field<%= errors.name ? ' field--error' : '' %>"><label for="name">Получатель</label><input id="name" name="name" value="<%= form.name || '' %>" autocomplete="off"><% if (errors.name) { %><span class="field__error"><%= errors.name %></span><% } %></div>
  <div class="field<%= errors.iban ? ' field--error' : '' %>"><label for="iban">Номер счёта получателя (IBAN)</label><input id="iban" name="iban" value="<%= form.iban || '' %>" autocomplete="off" placeholder="BY00 DRZH 2400 0000 0000 0000 0001">
    <span class="field__hint">Банк определяется по символам 5-8 номера: <%= banks.filter((b) => b.active).map((b) => b.name + ' (' + b.code + ')').join(', ') %></span>
    <% if (errors.iban) { %><span class="field__error"><%= errors.iban %></span><% } %></div>
  <div class="field<%= errors.amount ? ' field--error' : '' %>"><label for="amount">Сумма, BYN</label><input id="amount" name="amount" value="<%= form.amount || '' %>" inputmode="decimal" autocomplete="off"><span class="field__hint">Комиссия 0,5%, не меньше 0,50 BYN. Платёж уйдёт в банк получателя при закрытии операционного дня.</span><% if (errors.amount) { %><span class="field__error"><%= errors.amount %></span><% } %></div>
  <div class="field"><label for="purpose">Назначение платежа</label><input id="purpose" name="purpose" maxlength="140" value="<%= form.purpose || '' %>"></div>
  <div><button class="btn btn--lg" type="submit">Продолжить</button></div>
</form>
<section class="tile">
  <h2 class="mb10">Мои переводы в другие банки</h2>
  <% const names = { pending_otp: 'ждёт подтверждения', queued: 'в очереди клиринга', sent: 'отправлен', rejected: 'отклонён', cancelled: 'отменён' }; %>
  <% if (!history.length) { %><p class="muted m0">Переводов пока нет.</p><% } %>
  <% history.forEach((t) => { %>
    <div class="account">
      <div><div class="account__title"><%= t.counterparty_name %>, <%= t.bank_name %></div><div class="account__iban"><%= names[t.status] %><%= t.reject_reason ? ': ' + t.reject_reason : '' %></div></div>
      <div class="actions"><div class="amount"><%= formatAmount(t.amount) %> <small>BYN</small></div>
        <% if (['queued', 'pending_otp'].includes(t.status)) { %><form method="post" action="/transfers/interbank/<%= t.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button text-bad" type="submit">Отменить</button></form><% } %></div>
    </div>
  <% }) %>
</section>
<%- include('../../partials/footer') %>
