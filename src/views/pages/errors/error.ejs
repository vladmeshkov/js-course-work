<%- include('../../partials/header', { title }) %>
<section class="tile w720">
  <div class="muted2"><%= status %></div>
  <h1 class="iban-line"><%= status === 404 ? 'Такой страницы нет' : 'Что-то пошло не так' %></h1>
  <p class="muted mb22"><%= message %></p>
  <a class="btn" href="/">На главную</a>
  <% if (details) { %><pre class="debug"><%= details %></pre><% } %>
</section>
<%- include('../../partials/footer') %>
