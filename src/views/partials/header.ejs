<%- include('head', { title }) %>
<header>
  <div class="util-bar">
    <div class="util-bar__in">
      <span><%= user ? user.role_name : 'Интернет-банкинг для физических лиц' %></span>
      <div class="util-bar__links">
        <a href="/rates">Курсы валют</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" title="Переключить тему"><span class="theme-toggle__icon" aria-hidden="true"></span><span data-theme-label>Тёмная тема</span></button>
        <% if (user) { %>
          <a href="/security">Безопасность</a>
          <a class="bell" href="/notifications" aria-label="Уведомления<%= unread ? ', непрочитанных: ' + unread : '' %>">Уведомления<% if (unread) { %><span class="bell__count"><%= unread > 99 ? '99+' : unread %></span><% } %></a>
        <% } %>
        <a class="phone-link" href="tel:147">147</a>
      </div>
    </div>
  </div>
  <div class="top-bar">
    <div class="top-bar__in">
      <a class="logo" href="/">
        <img src="/img/emblem.png" alt="Эмблема ТалерБанка: оранжевый круг с монограммой Тр" width="54" height="54">
        <span>Талер<span class="logo__bank">Банк</span></span>
      </a>
      <nav class="main-nav<%= nav.length > 5 ? ' main-nav--dense' : '' %>" aria-label="Основное меню">
        <% nav.forEach((item) => { %>
          <a href="<%= item.href %>"<%- currentPath === item.href ? ' aria-current="page"' : '' %>><%= item.label %></a>
        <% }) %>
      </nav>
      <div class="top-bar__actions">
        <% if (user) { %>
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--ghost btn--small" type="submit">Выйти &nbsp;→</button>
          </form>
        <% } else { %>
          <a class="btn btn--ghost btn--small" href="/login">Войти</a>
          <a class="btn btn--small" href="/register">Стать клиентом</a>
        <% } %>
      </div>
    </div>
  </div>
</header>
<main id="content" class="page">
<% if (flash) { %><div class="alert alert--<%= flash.type %>" role="status"><%= flash.message %></div><% } %>
