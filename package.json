{
  "name": "talerbank",
  "version": "0.1.0",
  "description": "ТалерБанк: система дистанционного банковского обслуживания физических лиц (курсовой проект)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node tools/setup.js",
    "start": "node --env-file=.env server/server.js",
    "dev": "node --watch --env-file=.env server/server.js",
    "db:migrate": "node --env-file=.env server/db/migrate.js",
    "db:seed": "node --env-file=.env server/db/seed.js",
    "scoring:train": "node --env-file=.env tools/train-scoring.js",
    "er:drawio": "node --env-file=.env tools/er-drawio.js",
    "uml:drawio": "node tools/uml-drawio.js",
    "uml:classes": "node tools/class-diagrams.js",
    "uml:views": "node tools/uml-views.js",
    "db:schema": "node tools/build-schema.js",
    "test": "vitest run",
    "db:demo": "node --env-file=.env tools/demo-data.js",
    "staff2fa:off": "node --env-file=.env tools/staff-2fa.js off",
    "staff2fa:on": "node --env-file=.env tools/staff-2fa.js on"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
